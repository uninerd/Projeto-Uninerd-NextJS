{
  "name": "uninerd",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:apps": "npm ci --prefix frontend && npm ci --prefix backend && npm ci --prefix microservices/notifications",
    "dev": "npm run dev:frontend",
    "dev:frontend": "node frontend/node_modules/next/dist/bin/next dev frontend --port 3000",
    "dev:backend": "node --env-file=.env backend/node_modules/next/dist/bin/next dev backend --port 3001",
    "dev:notifications": "npm run dev --prefix microservices/notifications",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "test": "tsx --test tests/*.test.ts",
    "docs:api": "tsx scripts/generate-openapi.ts",
    "test:integration": "tsx --env-file=.env --test tests/integration/*.test.ts",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "seed": "node --env-file=.env backend/scripts/seed-admin.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "docs:check": "tsx scripts/generate-openapi.ts --check && redocly lint contracts/openapi.json",
    "test:resilience": "tsx --env-file=.env scripts/test-resilience.ts",
    "release": "node scripts/release.mjs",
    "test:release": "node scripts/test-release.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@redocly/cli": "^1.34.5",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  }
}
