# Generate .env with: node scripts/setup-env.mjs
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
APP_BIND_ADDRESS=0.0.0.0
COOKIE_SECURE=false
JWT_SECRET=replace-with-at-least-32-random-characters
MYSQL_ROOT_PASSWORD=replace-with-random-password
MYSQL_DATABASE=uninerd_db
MYSQL_USER=uninerd
MYSQL_PASSWORD=replace-with-random-password
DB_HOST=localhost
DB_PORT=3317
DB_NAME=uninerd_db
DB_USER=uninerd
DB_PASSWORD=replace-with-same-MYSQL_PASSWORD
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
NOTIFICATIONS_URL=http://localhost:3002
NOTIFICATIONS_INTERNAL_KEY=replace-with-random-internal-key
ADMIN_EMAIL=admin@uninerd.local
ADMIN_PASSWORD=choose-a-strong-password
