{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "esnext"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "resolveJsonModule": true, "paths": { "@/*": ["./backend/src/*"] }
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
